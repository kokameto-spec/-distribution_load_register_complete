rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /app_users/{username} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /vehicles/{vehicleCode} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /fuelings/{fuelingId} {
      allow read, create, update, delete: if signedIn();
    }

    match /fueling_images/{imageId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.data is bytes
        && request.resource.data.order >= 1
        && request.resource.data.order <= 4;
    }

    match /consumption/{entryId} {
      allow read, create, update, delete: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
